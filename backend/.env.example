# ==============================================================================
# Sabir Plastic ERP - Backend Production Environment Blueprint
# ==============================================================================

# ─── Node & Application Environment ───────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://erp.yourdomain.com

# ─── PostgreSQL Database Configuration ────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sabir_plastic_erp
DB_USER=erp_user
DB_PASSWORD=your_secure_db_password_here
# Set DB_SSL to true if connecting to a cloud-managed database (e.g. RDS, Supabase, Neon)
DB_SSL=false

# ─── Authentication & JWT Security ────────────────────────────────────────────
# Must be at least 16 characters long. Generate using: openssl rand -base64 32
JWT_SECRET=generate_strong_random_secret_at_least_16_chars_long
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── Email / SMTP Gateway (Transactional Emails & Password Resets) ─────────────
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_app_password_here
EMAIL_FROM="Sabir Plastic Store <no-reply@yourdomain.com>"
