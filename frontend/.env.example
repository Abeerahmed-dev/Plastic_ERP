# Base URL for Backend REST API
# In production with Nginx reverse proxy on the same domain, use: /api/v1
# In cross-origin deployments (e.g., S3/CloudFront/Vercel), use: https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
